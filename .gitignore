# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# claude code local-only settings
CLAUDE.local.md

# bkit plugin — 세션별 감사 로그(audit/*.jsonl)와 로컬 상태(state/*.json)
/.bkit/

# vercel
.vercel

# cloudflare
# .wrangler: 로컬 D1 상태(실제 DB 파일). .open-next: 어댑터 빌드 산출물.
# worker-configuration.d.ts는 생성물이지만 커밋한다 — 없으면 npm install 직후
# 타입이 깨지고, 되살리려면 wrangler 실행이 필요해 진입 장벽이 된다.
/.wrangler/
/.open-next/

# typescript
*.tsbuildinfo
next-env.d.ts
